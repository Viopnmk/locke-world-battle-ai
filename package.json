{
  "name": "locke-world-battle-ai",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "data:fetch": "python3 scripts/fetch-wiki.py",
    "worker:deploy": "cd worker && npx wrangler deploy",
    "deploy:web": "npm run build && npx wrangler pages deploy dist --project-name=locke-world-battle-ai --branch=main",
    "verify:tactics": "npx esbuild scripts/verify-tactics.ts --bundle --platform=node --format=esm --outfile=.cache/verify-tactics.mjs && node .cache/verify-tactics.mjs",
    "verify:teams": "npx esbuild scripts/verify-teams.ts --bundle --platform=node --format=esm --outfile=.cache/verify-teams.mjs && node .cache/verify-teams.mjs",
    "verify:bloodlines": "npx esbuild scripts/verify-bloodlines.ts --bundle --platform=node --format=esm --outfile=.cache/verify-bloodlines.mjs && node .cache/verify-bloodlines.mjs",
    "screen:mixed": "npx esbuild scripts/screen-mixed.ts --bundle --platform=node --format=esm --outfile=.cache/screen-mixed.mjs && node .cache/screen-mixed.mjs",
    "rotate:teams": "npx esbuild scripts/rotate-teams.ts --bundle --platform=node --format=esm --outfile=.cache/rotate-teams.mjs && node .cache/rotate-teams.mjs",
    "verify:build-guide": "npx esbuild scripts/verify-build-guide.ts --bundle --platform=node --format=esm --outfile=.cache/verify-build-guide.mjs && node .cache/verify-build-guide.mjs",
    "test:audit": "npx esbuild scripts/test-team-audit.ts --bundle --platform=node --format=esm --outfile=.cache/test-team-audit.mjs && node .cache/test-team-audit.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}